Description: 
Write the code for the following problem. Create a dictionary with student name as the key and
the grade as the value. Print student names and grades and class average grade in two columns
with a header for each column.
"""
# Create dictionary of students and grades
students = {
    "Adam": 85,
    "Tony": 90,
    "Jonny": 78,
    "Aidan": 92,
    "Nick": 88
}

# Print header
print(f"{'Student Name':<15}{'Grade':<10}")
print("------------------------")

# Print student names and grades
total = 0
for name, grade in students.items():
    print(f"{name:<15}{grade:<10}")
    total += grade

# Calculate and print class average
average = total / len(students)
print("------------------------")
print(f"{'Class Average':<15}{average:<10.2f}")
