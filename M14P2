Description:
Create a student class. This class should consist of student
first name, student last name, district code (I or O) and enrolled credits.
Create a method to compute tuition owed. Tuition owed should be
enrolled credits times $250.00 per credit hour for in district students
(district code of I) and or times $500.00 per credit hour for out of
district students (district code of anything other than I).
Test the class by instantiating the object and adding data.
"""

class student:
    first_name = ""
    last_name = ""
    district_code = ""
    enrolled_credits = 0
    
    def calculate_tuition(self):
        if self.district_code == "I":
            tuition = 250 * self.enrolled_credits
            return tuition
        else:
            tuition = 500 * self.enrolled_credits
            return tuition
    
#create an instance of student
student1 = student()
student2 = student()

student1.first_name = "Adam"
student1.last_name = "Kingery"
student1.district_code = "I"
student1.enrolled_credits = 12

print(f'name: {student1.first_name}')

print(f'tuition cost: {student1.calculate_tuition()}')

student2.first_name = "Joe"
student2.last_name = "Bartolozzi"
student2.district_code = "O"
student2.enrolled_credits = 12

print(f'name: {student2.first_name}')

